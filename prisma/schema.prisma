generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResets PasswordReset[]
  appointments   Appointment[]
}

model Barber {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String   @unique
  email     String   @unique
  password  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workingHours WorkingHours[]
  appointments Appointment[]
}

model PasswordReset {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model WorkingHours {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  barberId   String   @db.ObjectId
  barber     Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado
  startTime  String   // Formato "08:00"
  endTime    String   // Formato "18:00"
  breakStart String?  // Formato "12:00"
  breakEnd   String?  // Formato "13:00"
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([barberId, dayOfWeek])
}

model Service {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  price       Float
  duration    Int           // Duração em minutos (ex: 30, 45, 60)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  appointments Appointment[]
}

model Appointment {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime          // Data e hora de início do atendimento
  status    AppointmentStatus @default(PENDING)
  
  clientId  String            @db.ObjectId
  client    User              @relation(fields: [clientId], references: [id])
  
  barberId  String            @db.ObjectId
  barber    Barber            @relation(fields: [barberId], references: [id])
  
  serviceId String            @db.ObjectId
  service   Service           @relation(fields: [serviceId], references: [id])

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([barberId, date])
  @@index([clientId, status])
  @@index([status, date])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  FINISHED
}