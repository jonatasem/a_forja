generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  BARBER
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  role      Role     @default(CLIENT) // padrao cliente
  status    Status   @default(ACTIVE) // padrao ativo
  name      String
  phone     String   @unique // unicos
  email     String   @unique // unicos
  password  String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResets     PasswordReset[]
  clientAppointments Appointment[]    @relation("ClientAppointments")
  barberAppointments Appointment[]    @relation("BarberAppointments")
  workLoad       WorkLoad[]
  TimeOffs     TimeOff[]
}

model TimeOff {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  barberId  String   @db.ObjectId
  // (Exclusao em cascata)
  barber    User     @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([barberId, startTime, endTime])
}

model PasswordReset {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique

  userId    String   @db.ObjectId
  // Ao deletar usuario, ele apaga o seu historico de PassswordReset (Exclusao em cascata)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
}

// // Modelo de Carga Horaria
model WorkLoad  {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  barberId   String   @db.ObjectId
  // (Exclusao em cascata)
  barber     User     @relation(fields: [barberId], references: [id], onDelete: Cascade)

  dayOfWeek  Int      // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado

  startTime  String   // Formato "08:00"
  endTime    String   // Formato "18:00"
  breakStart String?  // Formato "12:00"
  breakEnd   String?  // Formato "13:00"

  active     Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([barberId, dayOfWeek])
}

// Modelo de serviços
model Service {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  price       Float
  duration    Int           // Duração em minutos
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  appointmentIds String[]      @db.ObjectId
  appointments   Appointment[] @relation(fields: [appointmentIds], references: [id])
}

// Modelo de Agendamentos
model Appointment {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  status    AppointmentStatus @default(PENDING)

  clientId  String            @db.ObjectId
  client    User              @relation("ClientAppointments", fields: [clientId], references: [id])
  
  barberId  String            @db.ObjectId
  barber    User              @relation("BarberAppointments", fields: [barberId], references: [id])
  
  serviceIds String[]         @db.ObjectId
  services   Service[]        @relation(fields: [serviceIds], references: [id])

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([barberId, date])
  @@index([clientId, status])
  @@index([status, date])
}

// Status dos Agendamentos
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  FINISHED
}